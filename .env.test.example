# examples/mercadopago/demo-ui.tsx — TEST mode (`npm run demo:ui`, the default)
#
# Copy this file to `.env.test` and fill in real values if you want. Every
# var here is optional — leave them all empty and the demo still runs fully,
# falling back to its local Mercado Pago simulator and a fresh throwaway
# Stellar issuer. This is the safe mode: Mercado Pago is ALWAYS constructed
# with `sandbox: true` here, regardless of what's in this file — even a real,
# production `MP_*_ACCESS_TOKEN` can't place a genuine chargeable preference
# while running `npm run demo:ui`. For a mode that CAN place real charges,
# see `.env.production.example` instead (`npm run demo:ui:prod`).
#
# Only the vars demo-ui.tsx itself reads live here — the rest of the repo's
# example scripts (flow:koywe, flow:sep, flow:etherfuse...) still read the
# single root `.env` / `.env.example`, unrelated to this file.

# Port the web server listens on. Defaults to 4000 in test mode (4001 in
# production — see .env.production.example), so both can run at once.
PORT=""

# ---------------------------------------------------------------------------
# Mercado Pago (AR, BR)
# ---------------------------------------------------------------------------
# Real sandbox/test-user credentials, if you have them — from
# https://www.mercadopago.com.ar/developers/panel/app (AR) or
# https://www.mercadopago.com.br/developers/panel/app (BR). Leave empty and
# demo-ui.tsx falls back to its local, in-memory simulator for that account
# (safe/deterministic/no external calls, still enough to walk the full UI).
# Production mode does NOT do this — there an account with no token is dropped
# from the picker instead. See .env.production.example.
MP_AR_ACCESS_TOKEN=""
MP_AR_WEBHOOK_SECRET=""
MP_BR_ACCESS_TOKEN=""
MP_BR_WEBHOOK_SECRET=""

# Public URL that currently tunnels to this machine (e.g. localto.net,
# ngrok) — only matters if you filled in a real access token above, so
# Mercado Pago's sandbox webhooks can reach `/webhooks/<provider-name>`.
# Mock-backed accounts (no token set) ignore this. Defaults to
# https://stellarsummit.localto.net if left empty.
PUBLIC_BASE_URL=""

# ---------------------------------------------------------------------------
# CoinGecko (rate oracle) — optional, works without a key for light usage
# ---------------------------------------------------------------------------
COINGECKO_API_KEY=""

# ---------------------------------------------------------------------------
# Etherfuse — always sandbox, regardless of --env (no separate prod mode
# exists for it in this demo)
# ---------------------------------------------------------------------------
# Sandbox key from https://docs.etherfuse.com.
ETHERFUSE_API_KEY=""

# ---------------------------------------------------------------------------
# Abroad Finance — DELIBERATELY ABSENT FROM THIS FILE
# ---------------------------------------------------------------------------
# There is no ABROAD_API_KEY here, and setting one would do nothing: test
# mode never registers Abroad.
#
# Abroad has no sandbox. Every corridor it publishes is Stellar MAINNET
# (`GET /public/corridors` reports chainId "stellar:pubnet" for all of them),
# so a checkout there is a real PIX charge delivering real Circle USDC —
# which is the opposite of what this mode promises everywhere else. Rather
# than put one live rail in a picker where every other card is sandboxed or
# mocked, demo-ui.tsx skips it outright unless --env=production.
#
# Its credentials live in .env.production. See .env.production.example.

# ---------------------------------------------------------------------------
# Stellar — this demo's own self-issued "USDC" (not real Circle USDC)
# ---------------------------------------------------------------------------
# Leave empty and the demo mints a fresh, Friendbot-funded throwaway issuer
# every restart (simplest, but every restart is a DIFFERENT asset). Set this
# to a testnet secret ("S...") to reuse the SAME issuer across restarts —
# e.g. from `node -e "console.log(require('@stellar/stellar-sdk').Keypair.random().secret())"`.
# Testnet only, never a mainnet secret.
STELLAR_ISSUER_SECRET=""
