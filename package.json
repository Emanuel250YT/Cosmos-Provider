{
  "name": "cosmos-providers",
  "version": "0.1.0",
  "description": "Provider-agnostic crypto onramp/offramp toolkit for Latin America: Mercado Pago QR & payment links, PIX, SPEI, Koywe and Etherfuse anchors to USDC on Stellar, composable SEP-1/10/24 helpers, CoinGecko pricing with configurable spread, automatic USDC settlement, and signed webhooks. TypeScript, isomorphic (Node >= 18 and browsers).",
  "keywords": [
    "onramp",
    "offramp",
    "mercadopago",
    "pix",
    "spei",
    "usdc",
    "stablecoin",
    "coingecko",
    "qr",
    "payments",
    "webhooks",
    "latam",
    "etherfuse",
    "koywe",
    "stellar",
    "sep-24",
    "sep-10"
  ],
  "license": "MIT",
  "author": "Cosmos",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./webhooks": {
      "types": "./dist/webhooks/index.d.ts",
      "import": "./dist/webhooks/index.js",
      "require": "./dist/webhooks/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "readme",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "vitest run tests/e2e.test.ts",
    "flow": "tsx examples/full-flow.ts",
    "flow:mercadopago:link": "tsx examples/mercadopago-payment-link.ts",
    "flow:mercadopago:pix": "tsx examples/mercadopago-pix.ts",
    "flow:koywe": "tsx examples/koywe-full-flow.ts",
    "flow:sep": "tsx examples/sep-full-flow.ts",
    "flow:all": "tsx examples/all-flows.ts",
    "demo": "tsx examples/run-all.ts",
    "demo:ui": "tsx examples/demo-ui.ts",
    "prepublishOnly": "npm run typecheck && npm run build && npm run test"
  },
  "dependencies": {
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@stellar/stellar-sdk": "^16.2.0",
    "@types/node": "^22.20.1",
    "@types/qrcode": "^1.5.5",
    "dotenv": "^17.4.2",
    "js-sha3": "^0.12.0",
    "tsup": "^8.3.5",
    "tsx": "^4.23.1",
    "typescript": "^5.7.2",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "esbuild": "^0.28.1"
  }
}
