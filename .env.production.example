# examples/mercadopago/demo-ui.tsx — PRODUCTION mode (`npm run demo:ui:prod`)
#
# Copy this file to `.env.production` and fill in your REAL Mercado Pago
# account credentials. Unlike `.env.test`/`npm run demo:ui`, this mode can
# place a genuine, chargeable Mercado Pago preference — controlled by
# MP_SANDBOX below, not by demo-ui.tsx's code. Know what you're testing
# against before you fill this in and run `npm run demo:ui:prod`.
#
# NO SIMULATOR FALLBACK HERE. Test mode substitutes a local mock for any
# provider whose API key is missing; production does not — a provider with no
# key is simply not registered, so it disappears from the payment-method
# picker entirely instead of quietly offering fake payments. Whatever the
# picker lists in this mode is backed by a real account. The demo refuses to
# start if that leaves it with no providers at all.
#
# Only the vars demo-ui.tsx itself reads live here — the rest of the repo's
# example scripts (flow:koywe, flow:sep, flow:etherfuse...) still read the
# single root `.env` / `.env.example`, unrelated to this file.

# Port the web server listens on. Defaults to 4001 in production (4000 in
# test — see .env.test.example), so both can run at once, e.g. to compare
# sandbox vs. real behavior side by side.
PORT=""

# ---------------------------------------------------------------------------
# Mercado Pago (AR, BR) — REAL credentials
# ---------------------------------------------------------------------------
# From https://www.mercadopago.com.ar/developers/panel/app (AR) or
# https://www.mercadopago.com.br/developers/panel/app (BR). Leave an account's
# ACCESS_TOKEN empty and that account is dropped from the picker in this mode
# (no simulator fallback — see the header). Filling in only one is fine; you
# then get a single-country demo.
#
# The WEBHOOK_SECRET is the one from the same app's Webhooks panel. Its
# account's real notifications are consumed at
# <PUBLIC_BASE_URL>/webhooks/mercadopago-ar (and .../mercadopago-br) —
# demo-ui.tsx registers that `notification_url` on every charge it creates for
# a credentialed account, and that inbound POST is the ONLY thing that
# completes a real order: the demo never fabricates a payment for a real
# account. Set the secret so the `x-signature` header is verified; leave it
# empty and webhooks are accepted unverified (never do that with a real
# account). An order that stays "pending" after you've genuinely paid almost
# always means the webhook never arrived — check PUBLIC_BASE_URL below.
MP_AR_ACCESS_TOKEN=""
MP_AR_WEBHOOK_SECRET=""
MP_BR_ACCESS_TOKEN=""
MP_BR_WEBHOOK_SECRET=""

# "true" (default if unset) or "false". This is the ONE switch between "real
# account, but still sandboxed — no money moves" and "genuinely chargeable
# preferences, real money moves". Mercado Pago issues the same "APP_USR-..."
# token prefix for real accounts AND test users, so this can't be inferred
# from the token — it's an explicit, deliberate choice.
#
# MP_SANDBOX="false" REQUIRES STELLAR_NETWORK="public" below, and the demo
# refuses to start otherwise. Charging real pesos while the crypto leg pays
# out a self-issued testnet token is real money in and nothing of value out.
MP_SANDBOX="true"

# Public URL that currently tunnels to this machine (e.g. localto.net,
# ngrok) — REQUIRED once MP_SANDBOX="false" with a real token, so Mercado
# Pago's real webhooks can reach `/webhooks/<provider-name>`. Defaults to
# https://stellarsummit.localto.net if left empty — that placeholder will
# NOT actually reach your machine; set this for real before going live.
PUBLIC_BASE_URL=""

# ---------------------------------------------------------------------------
# CoinGecko (rate oracle) — optional
# ---------------------------------------------------------------------------
COINGECKO_API_KEY=""

# ---------------------------------------------------------------------------
# Etherfuse — always sandbox, regardless of --env (no separate prod mode
# exists for it in this demo)
# ---------------------------------------------------------------------------
# Leave empty and Etherfuse is dropped from the picker in this mode, same as
# an uncredentialed Mercado Pago account — there's no mock for it, so a keyless
# Etherfuse could only fail at checkout.
ETHERFUSE_API_KEY=""

# ---------------------------------------------------------------------------
# Abroad Finance (BRL via PIX, Brazil) — PRODUCTION MODE ONLY
# ---------------------------------------------------------------------------
# Abroad has no sandbox — every corridor it publishes is Stellar mainnet — so
# `--env=test` refuses to register it at all, whatever `.env.test` contains.
# This file is the only place its credentials do anything.
#
# Note what Abroad can do in PRODUCTION specifically: this mode is BUY ONLY.
# The "Sell USDC" operation is removed from the menu entirely (and /api/sell
# refuses) because this demo's operator has no bank payout API on mainnet —
# a sell here would take real USDC and owe fiat nobody can send. Abroad's own
# COP/BREB payout corridor is therefore unreachable in production; it's
# exercised in test mode.
#
# Abroad delivers real Circle USDC on Stellar mainnet ITSELF — it never
# touches STELLAR_DISTRIBUTOR_SECRET below, and this demo skips its own
# settlement for Abroad orders. So an Abroad buy works even with
# STELLAR_NETWORK="testnet": the buyer's wallet is checked against, and paid
# on, MAINNET regardless.
#
# Partner key from https://app.abroad.finance (looks like "partner_...").
ABROAD_API_KEY=""

# Partner-scoped end-user id for Abroad's KYC record and transaction
# ownership. Use your own stable per-user id in a real integration — a shared
# id means a shared KYC record. Defaults to "cosmos-demo-user".
ABROAD_USER_ID=""

# HMAC secret for verifying Abroad's webhooks, from its partner portal. Set
# this in production: left empty, webhook payloads are accepted unverified.
ABROAD_WEBHOOK_SECRET=""

# ---------------------------------------------------------------------------
# Stellar — which network the crypto leg settles on
# ---------------------------------------------------------------------------
# "testnet" (default) or "public". These are two different arrangements, not
# just a different URL:
#
#   testnet — this demo ISSUES the "USDC" it pays out. An issuing account can
#     send its own asset with no balance of its own, so there's nothing to
#     fund beyond fees (Friendbot handles it). What the buyer receives is this
#     demo's token, worth nothing. Fine for walking the flow; MP_SANDBOX must
#     stay "true".
#
#   public — nobody can issue Circle's USDC, so payouts come out of a
#     DISTRIBUTOR account you own that already holds a real USDC balance.
#     Every completed order spends real USDC. There is no Friendbot: the
#     distributor needs XLM for fees, and each buyer's wallet must already
#     trust the asset (the demo checks this BEFORE creating the charge and
#     refuses checkout otherwise, so nobody pays for an undeliverable order).
STELLAR_NETWORK="testnet"

# --- STELLAR_NETWORK="public" only -----------------------------------------
# Secret key ("S...") of the mainnet account that HOLDS the USDC being paid
# out and signs every release. It needs: a USDC trustline, enough USDC to
# cover the orders you expect, and XLM for fees + reserves. This key can move
# real money — treat it accordingly.
STELLAR_DISTRIBUTOR_SECRET=""
# Issuer of the asset to pay out. Defaults to Circle's mainnet USDC
# (GA5ZSEJYB37JRC5AVCIA5MOP4RHTM335X2KGX3IHOJAPP5RE34K4KZVN) — override only
# if you're deliberately settling in a different USDC.
STELLAR_USDC_ISSUER=""

# --- STELLAR_NETWORK="testnet" only ----------------------------------------
# Testnet secret ("S...") of the account that issues this demo's own "USDC".
# Leave empty and a throwaway issuer is minted each restart (so every restart
# is a DIFFERENT asset). Never a mainnet secret — on mainnet the payout
# account is STELLAR_DISTRIBUTOR_SECRET above, and it doesn't issue anything.
STELLAR_ISSUER_SECRET=""

# Horizon override, for either network (proxy, private instance). Defaults to
# https://horizon.stellar.org on public, https://horizon-testnet.stellar.org
# on testnet.
STELLAR_HORIZON_URL=""

# Horizon for MAINNET specifically, used only for Abroad orders when
# STELLAR_NETWORK="testnet" — the demo keeps a second, always-mainnet
# connection to check and open the buyer's Circle-USDC trustline, since
# that's where Abroad actually delivers. Defaults to
# https://horizon.stellar.org. Ignored when STELLAR_NETWORK="public"
# (STELLAR_HORIZON_URL already is mainnet then).
STELLAR_MAINNET_HORIZON_URL=""
