# cosmos-providers — environment variables
#
# Copy this file to `.env` and fill in real values. Everything here is read
# by the scripts in `examples/` (npm run demo / demo:ui / flow) — the library
# itself never reads process.env directly, so none of this is required when
# you consume cosmos-providers as a dependency and wire your own config.
#
# Nothing here needs to be "live" money: every provider below has a sandbox
# mode you can exercise end-to-end before touching production credentials.

# ---------------------------------------------------------------------------
# Mercado Pago (AR, BR, MX, CL, CO, PE, UY)
# ---------------------------------------------------------------------------
# Access token from https://www.mercadopago.com/developers/panel/app.
# A "TEST-..." token (from a test/sandbox application) puts the provider in
# sandbox mode automatically — payment links use sandbox_init_point and can
# be paid with test users/cards:
# https://www.mercadopago.com.ar/developers/en/docs/checkout-pro/additional-content/your-integrations/test/accounts
MP_ACCESS_TOKEN="TEST-0000000000000000-000000-00000000000000000000000000000000-000000000"
# Webhook secret from the same app's dashboard (Webhooks section). Required
# to verify the `x-signature` header; without it, webhooks are accepted
# unverified (fine for local testing, never for production).
MP_WEBHOOK_SECRET=""

# ---------------------------------------------------------------------------
# CoinGecko (rate oracle) — optional
# ---------------------------------------------------------------------------
# Demo/Pro API key for higher rate limits. The public /simple/price endpoint
# works without one for light/local usage.
COINGECKO_API_KEY=""

# ---------------------------------------------------------------------------
# Etherfuse (PIX/BRL and SPEI/MXN ramp API)
# ---------------------------------------------------------------------------
# Sandbox key from https://docs.etherfuse.com — EtherfuseClient defaults to
# `environment: "sandbox"`, so this key alone is enough to run `npm run flow`.
ETHERFUSE_API_KEY=""
# Chain to receive/send the crypto leg on. Default in examples: "solana".
ETHERFUSE_BLOCKCHAIN="solana"
# Asset mint/contract on that chain. Default in examples: USDC on Solana.
ETHERFUSE_TARGET_ASSET="EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v"
# Your on-chain wallet address. Optional — examples create/reuse a sandbox one when omitted.
ETHERFUSE_WALLET=""
# Webhook secret returned ONCE when you create an Etherfuse webhook
# (`client.webhooks.create(...)`). Used by examples/webhook-server.ts.
ETHERFUSE_WEBHOOK_SECRET=""

# ---------------------------------------------------------------------------
# Koywe (ARS/CLP/MXN/COP/PEN/BRL <-> USDC on Stellar)
# ---------------------------------------------------------------------------
# clientId/secret pair from https://docs-crypto.koywe.com. Server-side only.
KOYWE_CLIENT_ID=""
KOYWE_SECRET=""
# Sandbox: https://api-sandbox.koywe.com — switch to the production base URL
# only once you're ready to move real money.
KOYWE_BASE_URL="https://api-sandbox.koywe.com"

# ---------------------------------------------------------------------------
# Stellar (shared by Koywe and the SEP-1/10/24 anchor helpers)
# ---------------------------------------------------------------------------
# Issuer account of the USDC trustline Koywe delivers to. Testnet USDC issuer
# shown below; swap for the mainnet issuer before going live.
PUBLIC_USDC_ISSUER="GBBD47IF6LWK7P7MDEVSCWR7DPUWV3NY3DTQEVFL4NAT4AQH3ZLLFLA5"
# "testnet" while developing against any SEP-compliant anchor's testnet
# deployment (e.g. testanchor.stellar.org); "public" in production.
STELLAR_NETWORK="testnet"

# ---------------------------------------------------------------------------
# Misc
# ---------------------------------------------------------------------------
# Any truthy value turns on verbose client logging in examples/full-flow.ts.
DEBUG=""
