# cosmos-providers — environment variables
# 
# Copy this file to `.env` and fill in real values. Everything here is read
# by the scripts in `examples/` (npm run demo / demo:ui / flow*) — the
# library itself never reads process.env directly, so none of this is
# required when you consume cosmos-providers as a dependency and wire your
# own config (see CosmosClient / MercadoPagoProvider / KoyweClient / etc.).
# 
# SANDBOX BY DEFAULT: every var below is either empty or a sandbox/testnet
# URL — nothing here can move real money on its own. Mercado Pago is the one
# exception worth calling out below: sandbox vs. production for it is a code
# decision (see examples/mercadopago/payment-link.ts), never something read
# from this file.

# ---------------------------------------------------------------------------
# Mercado Pago (AR, BR, MX, CL, CO, PE, UY)
# ---------------------------------------------------------------------------
# Mercado Pago issues a SEPARATE merchant account (and access token) per
# country — there's no "default" account, so only the per-country vars below
# exist. `new CosmosClient({ mercadopago: { accounts: { ARS: {...}, BRL:
# {...} } } })` takes both at once (see README, "Mercado Pago multi-account").
# 
# Sandbox vs. production is NOT read from this file or guessed from the
# token: Mercado Pago issues the same "APP_USR-..." prefix for real accounts
# AND for every "usuario de prueba" (test user / sandbox account) you
# create, so the prefix alone proves nothing. It's a plain config value
# (`sandbox: true/false`) you pass explicitly when constructing the provider
# in your own code — examples/mercadopago/payment-link.ts, pix.ts and
# demo-ui.tsx all hardcode `sandbox: true` since they're test/demo scripts,
# regardless of which token ends up in the vars below.

# Argentina (ARS) — from https://www.mercadopago.com.ar/developers/panel/app
MP_AR_ACCESS_TOKEN=""
# Webhook secret from the same app's dashboard (Webhooks section). Read by
# examples/quickstart.ts, examples/mercadopago/payment-link.ts and
# webhook-server.ts to verify the `x-signature` header; without it, webhooks
# are accepted unverified (fine for local testing, never for production).
MP_AR_WEBHOOK_SECRET=""
# Brazil (BRL) — from https://www.mercadopago.com.br/developers/panel/app
MP_BR_ACCESS_TOKEN=""
# Read by examples/quickstart.ts, examples/mercadopago/payment-link.ts,
# pix.ts and webhook-server.ts.
MP_BR_WEBHOOK_SECRET=""

# Public URL that currently tunnels to this machine (e.g. a localto.net or
# ngrok domain) — examples/mercadopago/demo-ui.tsx points every REAL Mercado
# Pago account's `notification_url` here so their webhooks can actually reach
# your local server (`/webhooks/<provider-name>`). Mock-backed accounts (no
# MP_*_ACCESS_TOKEN set) ignore this. Defaults to https://stellarsummit.localto.net
# if left empty — update it whenever the tunnel URL changes.
PUBLIC_BASE_URL=""

# ---------------------------------------------------------------------------
# CoinGecko (rate oracle) — optional
# ---------------------------------------------------------------------------
# Demo/Pro API key for higher rate limits. The public /simple/price endpoint
# works without one for light/local usage.
COINGECKO_API_KEY=""

# ---------------------------------------------------------------------------
# Etherfuse (PIX/BRL and SPEI/MXN ramp API) — always sandbox in the examples
# ---------------------------------------------------------------------------
# Sandbox key from https://docs.etherfuse.com. examples/etherfuse/full-flow.ts
# and examples/etherfuse/quickstart.ts are hardcoded to `environment:
# "sandbox"`, so this key alone is enough to run `npm run flow` (or
# `npm run flow:etherfuse:quickstart` for the single-chain version).
ETHERFUSE_API_KEY=""
# Only used by `npm test` -> tests/e2e.test.ts, for one optional live-sandbox
# assertion (listing the assets supported on Stellar) — skipped entirely if
# ETHERFUSE_WALLET is empty. Not read by examples/etherfuse/full-flow.ts.
ETHERFUSE_BLOCKCHAIN="solana"
ETHERFUSE_WALLET=""
# Asset mint/contract override. Onramps deliver an Etherfuse stablebond
# (CETES for MXN, TESOURO for BRL), NOT raw USDC — the sandbox rejects real
# stablecoin mints with "Non-stable assets are not supported". Leave empty to
# let examples/etherfuse/full-flow.ts (and tests/e2e.test.ts) pick the right
# stablebond mint per currency+chain (resolved live from `client.lookup.stablebonds()`).
ETHERFUSE_TARGET_ASSET=""
# Webhook secret returned ONCE when you create an Etherfuse webhook
# (`client.webhooks.create(...)`). Used by examples/etherfuse/webhook-server.ts.
ETHERFUSE_WEBHOOK_SECRET=""

# ---------------------------------------------------------------------------
# Koywe (ARS/CLP/MXN/COP/PEN/BRL <-> USDC on Stellar)
# ---------------------------------------------------------------------------
# clientId/secret pair issued directly by Koywe — there's no self-service
# signup, email hola@koywe.com or book a call (see
# https://docs-crypto.koywe.com/documentation/credentials). Server-side only.
# Both are required for every authenticated call — quotes (executable),
# orders, bank accounts, KYC — not just the initial auth exchange.
KOYWE_CLIENT_ID=""
KOYWE_SECRET=""
# "sandbox" (default, https://api-sandbox.koywe.com) or "production"
# (https://api.koywe.com — double-check against your Koywe dashboard before
# going live). KOYWE_BASE_URL below overrides this outright, e.g. for a proxy.
KOYWE_ENVIRONMENT="sandbox"
KOYWE_BASE_URL=""

# ---------------------------------------------------------------------------
# Stellar / SEP-1/10/24 (any SEP-compliant anchor) — always testnet in the examples
# ---------------------------------------------------------------------------
# Issuer account of the USDC trustline Koywe delivers to. Testnet USDC issuer
# shown below; swap for the mainnet issuer before going live.
PUBLIC_USDC_ISSUER="GBBD47IF6LWK7P7MDEVSCWR7DPUWV3NY3DTQEVFL4NAT4AQH3ZLLFLA5"
# Anchor domain examples/sep/full-flow.ts runs SEP-1/10/24 against. Default:
# testanchor.stellar.org (Stellar's public reference anchor, testnet — the
# example generates and Friendbot-funds its own throwaway keypair, so no
# credentials are needed here). Point it at any other SEP-compliant anchor's
# domain to try that one instead.
ANCHOR_DOMAIN=""
# examples/mercadopago/demo-ui.tsx ONLY — the secret key of the Stellar
# testnet account that ISSUES that demo's own "USDC" (a self-minted demo
# asset, NOT the real Circle testnet USDC that PUBLIC_USDC_ISSUER above
# points at) and releases it to buyers on every completed order. Leave empty
# and the demo mints a fresh, Friendbot-funded throwaway issuer every server
# restart — simplest, but every restart is a DIFFERENT asset (same code,
# different issuer), so anything released by a previous run becomes
# worthless. Set this to reuse the SAME issuer across restarts instead — a
# real testnet secret key ("S..."), e.g. from `Keypair.random().secret()` or
# Stellar Laboratory's "Generate keypair", funded once (the demo Friendbot-
# funds it automatically on first use if it doesn't exist yet). Testnet only
# — never a mainnet secret.
STELLAR_ISSUER_SECRET=""

# ---------------------------------------------------------------------------
# Misc
# ---------------------------------------------------------------------------
# Any truthy value turns on verbose client logging in
# examples/etherfuse/full-flow.ts and examples/koywe/full-flow.ts.
DEBUG=""
