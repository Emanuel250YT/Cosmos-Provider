{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"]
    },
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "types": ["node"]
  },
  "include": ["src", "tests", "examples", "vitest.config.ts"],
  "exclude": [
    // Illustrative snippets only — not meant to run standalone, and don't
    // pull in react/express as real dependencies just to type-check them.
    "examples/frontend-pix-qr.tsx",
    "examples/webhook-server.ts"
  ]
}
